@Composable
private fun McqScreen(
    index: Int, setIndex: (Int) -> Unit, chosen: Int, setChosen: (Int) -> Unit,
    checked: Boolean, check: () -> Unit, correctCount: Int, next: () -> Unit
) {
    val q = mcqs[index]
    Column(Modifier.fillMaxSize().verticalScroll(rememberScrollState()), verticalArrangement = Arrangement.spacedBy(10.dp)) {
        Text("Practice MCQ / अभ्यास प्रश्न", fontSize = 22.sp, fontWeight = FontWeight.Bold)
        Text("Question ${index + 1}/${mcqs.size} • Unit: ${q.unit}")
        Text(q.question, fontWeight = FontWeight.SemiBold)
        q.options.forEachIndexed { i, option ->
            Card(onClick = { if (!checked) setChosen(i) }, colors = CardDefaults.cardColors(containerColor = if (chosen == i) Color(0xFFDDEBFF) else MaterialTheme.colorScheme.surfaceVariant)) {
                Text(option, Modifier.fillMaxWidth().padding(14.dp))
            }
        }
        if (checked) {
            Text(if (chosen == q.answer) "Correct / सही उत्तर" else "Answer / सही उत्तर: ${q.options[q.answer]}",
                color = if (chosen == q.answer) Color(0xFF187344) else Color(0xFFB3261E), fontWeight = FontWeight.Bold)
            Text(q.explanation)
            Button(onClick = next, modifier = Modifier.fillMaxWidth()) { Text("Next question / अगला प्रश्न") }
        } else {
            Button(onClick = check, enabled = chosen >= 0, modifier = Modifier.fillMaxWidth()) { Text("Check answer / उत्तर जाँचें") }
        }
        Text("Correct answers in this session: $correctCount")
        Text("The starter includes illustrative practice questions, not a complete verified PYQ archive.", color = Color.DarkGray, fontSize = 12.sp)
    }
}

