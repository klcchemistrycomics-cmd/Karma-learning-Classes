private fun exportPdf(context: android.content.Context, content: String) {
    val pdf = PdfDocument()
    val width = 595
    val height = 842
    val margin = 40f
    val paint = Paint().apply { textSize = 11f; color = android.graphics.Color.BLACK; isAntiAlias = true }
    val lines = content.lines().flatMap { if (it.length <= 86) listOf(it) else it.chunked(86) }
    var index = 0
    var pageNum = 1
    while (index < lines.size) {
        val info = PdfDocument.PageInfo.Builder(width, height, pageNum).create()
        val page = pdf.startPage(info)
        var y = margin + 16f
        page.canvas.drawText("Karma Learning Classes - CSIR-NET Chemical Science", margin, y, paint)
        y += 24f
        while (index < lines.size && y < height - margin) {
            page.canvas.drawText(lines[index].take(100), margin, y, paint)
            y += 16f
            index++
        }
        pdf.finishPage(page)
        pageNum++
    }
    val values = ContentValues().apply {
        put(MediaStore.Downloads.DISPLAY_NAME, "Karma_CSIR_NET_Study_Notes.pdf")
        put(MediaStore.Downloads.MIME_TYPE, "application/pdf")
        put(MediaStore.Downloads.IS_PENDING, 1)
    }
    val resolver = context.contentResolver
